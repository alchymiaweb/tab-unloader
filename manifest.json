{
  "manifest_version": 3,
  "name": "Tab Unloader",
  "version": "1.0.0",
  "author": "Felipe Andrada <felipe.andrada@gmail.com>",
  "description": "Unload tabs from memory without closing them.",
  "permissions": ["tabs", "contextMenus"],
  "background": { "service_worker": "background.js" },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Tab Unloader",
    "default_popup": "popup.html",
    "default_icon": { "16": "icons/icon16.png", "32": "icons/icon32.png" }
  },
  "commands": {
    "unload-current-tab": {
      "suggested_key": { "default": "Alt+U" },
      "description": "Unload the current tab"
    }
  }
}
